SHELL := cmd.exe

PROJECT_ROOT := $(abspath ..)
MSPM0_SDK_INSTALL_DIR ?= C:/ti/mspm0_sdk_2_01_00_03
TICLANG_ARMCOMPILER ?= C:/ti/ti-cgt-armllvm_3.2.2.LTS
SYSCONFIG_TOOL ?= C:/ti/sysconfig_1.20.0/sysconfig_cli.bat

CC := "$(TICLANG_ARMCOMPILER)/bin/tiarmclang.exe"
LNK := "$(TICLANG_ARMCOMPILER)/bin/tiarmclang.exe"
SYSCFG := "$(SYSCONFIG_TOOL)" --compiler ticlang --product "$(MSPM0_SDK_INSTALL_DIR)/.metadata/product.json"

NAME := my_project_08012135

USER_SOURCES := \
    $(PROJECT_ROOT)/main.c \
    $(PROJECT_ROOT)/Board/board.c \
    $(PROJECT_ROOT)/Control/control.c \
    $(PROJECT_ROOT)/Encoder/encoder.c \
    $(PROJECT_ROOT)/Motor/motor.c \
    $(PROJECT_ROOT)/OLED/glcdfont.c \
    $(PROJECT_ROOT)/OLED/oled.c \
    $(PROJECT_ROOT)/OLED/ssd1306.c \
    $(PROJECT_ROOT)/UART_Gyro/uart_gyro.c

SYSCFG_SOURCES := \
    ti_msp_dl_config.c \
    $(MSPM0_SDK_INSTALL_DIR)/source/ti/devices/msp/m0p/startup_system_files/ticlang/startup_mspm0g350x_ticlang.c

USER_OBJECTS := $(patsubst %.c,%.obj,$(notdir $(USER_SOURCES)))
SYSCFG_OBJECTS := $(patsubst %.c,%.obj,$(notdir $(SYSCFG_SOURCES)))
OBJECTS := $(USER_OBJECTS) $(SYSCFG_OBJECTS)

INCLUDES := \
    -I"$(PROJECT_ROOT)" \
    -I"$(PROJECT_ROOT)/Board" \
    -I"$(PROJECT_ROOT)/Control" \
    -I"$(PROJECT_ROOT)/Encoder" \
    -I"$(PROJECT_ROOT)/Motor" \
    -I"$(PROJECT_ROOT)/OLED" \
    -I"$(PROJECT_ROOT)/UART_Gyro" \
    -I. \
    -I"$(MSPM0_SDK_INSTALL_DIR)/source/third_party/CMSIS/Core/Include" \
    -I"$(MSPM0_SDK_INSTALL_DIR)/source"

CFLAGS := \
    $(INCLUDES) \
    @device.opt \
    -O0 \
    -gdwarf-3 \
    -mcpu=cortex-m0plus \
    -march=thumbv6m \
    -mfloat-abi=soft \
    -mlittle-endian \
    -mthumb

LFLAGS := \
    -ldevice.cmd.genlibs \
    -L"$(MSPM0_SDK_INSTALL_DIR)/source" \
    -L. \
    device_linker.cmd \
    -Wl,-m,$(NAME).map \
    -Wl,--rom_model \
    -Wl,--warn_sections \
    -Wl,--display_error_number \
    -L"$(TICLANG_ARMCOMPILER)/lib" \
    -llibc.a

.PHONY: all syscfg

all: $(NAME).out

GENERATED_FILES := \
    device_linker.cmd \
    device.opt \
    device.cmd.genlibs \
    ti_msp_dl_config.c \
    ti_msp_dl_config.h \
    Event.dot

$(GENERATED_FILES): syscfg
	@ rem Generated by SysConfig.

syscfg: $(PROJECT_ROOT)/main.syscfg
	@ echo Generating SysConfig files...
	@ $(SYSCFG) --output . "$<"

$(OBJECTS): | syscfg

define USER_C_RULE
$(basename $(notdir $(1))).obj: $(1) ti_msp_dl_config.h
	@ echo Building $$@
	@ $(CC) $(CFLAGS) -c "$$<" -o "$$@"
endef

$(foreach source,$(USER_SOURCES),$(eval $(call USER_C_RULE,$(source))))

define SYSCFG_C_RULE
$(basename $(notdir $(1))).obj: $(1) ti_msp_dl_config.h
	@ echo Building $$@
	@ $(CC) $(CFLAGS) -c "$$<" -o "$$@"
endef

$(foreach source,$(SYSCFG_SOURCES),$(eval $(call SYSCFG_C_RULE,$(source))))

$(NAME).out: $(OBJECTS)
	@ echo Linking $@
	@ $(LNK) -Wl,-u,_c_int00 $(OBJECTS) $(LFLAGS) -o "$@"
